{
	"schemaVersion": 1,
	"id": "sdl-input",
	"version": "${version}",
	"name": "sdl-input",
	"description": "Makes SDL handle input for lower latency input and better item usage when holding down buttons.",
	"authors": [
		"Shikaru0"
	],
	"contact": {
		"homepage": "https://github.com/Shikaru0/sdl-input",
		"sources": "https://github.com/Shikaru0/sdl-input"
	},
	"license": "MIT",
	"icon": "assets/sdl-input/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.SdlInput"
		],
		"client": [
			"name.modid.client.SdlInputClient"
		],
		"modmenu": [
			"name.modid.client.config.SdlInputModMenuApi"
		]
	},
	"mixins": [
		"sdl-input.mixins.json",
		{
			"config": "sdl-input.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}